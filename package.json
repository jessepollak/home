{
  "name": "home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run db:migrate && bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck",
    "test": "bun run --cwd apps/web test",
    "check": "bun run gates && bun run test && bun run lint && bun run typecheck && bun run knip && bun run build",
    "ab": "sh scripts/verify/agent-browser.sh",
    "knip": "bun run --cwd apps/web knip",
    "gates": "node --test scripts/gates/tests/*.test.mjs",
    "caught-by-report": "node scripts/gates/caught-by-report.mjs",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "agent-browser": "0.38.1"
  }
}
