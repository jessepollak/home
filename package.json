{
  "name": "home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "engines": { "node": ">=22" },
  "workspaces": ["apps/*"],
  "scripts": {
    "dev": "bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck",
    "test": "bun run --cwd apps/web test",
    "check": "bun run test && bun run lint && bun run typecheck && bun run build",
    "money-actions:migrate": "bun run --cwd apps/web money-actions:migrate"
  },
  "trustedDependencies": ["sharp", "unrs-resolver"]
}
