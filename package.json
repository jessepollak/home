{
  "name": "home",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.12",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run db:migrate && bun run --cwd apps/web dev",
    "build": "bun run --cwd apps/web build",
    "start": "bun run --cwd apps/web start",
    "lint": "bun run --cwd apps/web lint",
    "typecheck": "bun run --cwd apps/web typecheck",
    "test": "bun run --cwd apps/web test",
    "check": "bun run gates && bun run test && bun run check:static",
    "check:static": "bun run lint && bun run typecheck && bun run knip && bun run build && bun run api-routes:dynamic && bun run css:built",
    "ab": "bun scripts/verify/agent-browser.ts",
    "clip": "bun scripts/verify/clip.ts",
    "knip": "bun run --cwd apps/web knip",
    "worktree:bootstrap": "node scripts/worktree/bootstrap.mjs",
    "worktree:verify-resolution": "node scripts/worktree/verify-resolution.mjs",
    "gates": "node scripts/gates/preflight.mjs && node --test scripts/gates/tests/*.test.mjs && bun test ./scripts/verify && node scripts/gates/library-catalog.mjs",
    "assertions:report": "node scripts/gates/type-assertions.mjs --report",
    "disables:shrink": "node scripts/gates/lint-disables.mjs --shrink",
    "lint-exemptions:shrink": "node scripts/gates/lint-exemptions.mjs --shrink",
    "css:built": "node scripts/gates/built-css.mjs",
    "api-routes:dynamic": "node scripts/gates/api-routes-dynamic.mjs",
    "caught-by-report": "node scripts/gates/caught-by-report.mjs",
    "db:migrate": "bun run --cwd apps/web db:migrate",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down"
  },
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ],
  "devDependencies": {
    "agent-browser": "0.38.1"
  },
  "patchedDependencies": {
    "@base-ui/react@1.8.0": "patches/@base-ui%2Freact@1.8.0.patch"
  }
}
