{
  "routes": {
    "access/logout/route.ts": { "exempt": { "kind": "redirect", "reason": "Logout clears the deployment-access cookie and redirects without a parsed response body." } },
    "access/route.ts": { "contracts": ["shared/access/contract.ts"] },
    "account/country-preference/route.ts": { "contracts": ["shared/account/contracts/country-preference.ts"], "methods": { "GET": { "contracts": ["shared/account/contracts/country-preference.ts"] }, "PUT": { "contracts": ["shared/account/contracts/country-preference.ts"] } } },
    "account/email-request/route.ts": { "contracts": ["shared/account/contracts/email-request.ts"], "methods": { "GET": { "contracts": ["shared/account/contracts/email-request.ts"] }, "POST": { "contracts": ["shared/account/contracts/email-request.ts"] } } },
    "account/export/route.ts": { "contracts": ["shared/account/contracts/data-export.ts"], "methods": { "GET": { "contracts": ["shared/account/contracts/data-export.ts"] } } },
    "actions/[id]/confirm/route.ts": { "contracts": ["shared/actions/contracts/confirm.ts"] },
    "actions/[id]/decline/route.ts": { "contracts": ["shared/actions/contracts/decline.ts"] },
    "actions/[id]/handle/route.ts": { "contracts": ["shared/actions/contracts/handle.ts"] },
    "actions/[id]/paymaster/route.ts": { "exempt": { "kind": "machine", "reason": "The wallet invokes this action-scoped JSON-RPC paymaster callback; Home does not parse its response body." } },
    "actions/[id]/retry/route.ts": { "contracts": ["shared/actions/contracts/retry.ts"] },
    "actions/[id]/route.ts": { "contracts": ["shared/actions/contracts/get.ts"] },
    "actions/network-fee/route.ts": { "contracts": ["shared/actions/contracts/network-fee.ts"] },
    "actions/prepare/route.ts": { "contracts": ["shared/actions/contracts/prepare.ts"] },
    "actions/route.ts": { "contracts": ["shared/actions/contracts/list.ts"] },
    "actions/trade-pending/route.ts": { "contracts": ["shared/actions/contracts/trade-pending.ts"], "client": "No Home client fetcher consumes this pending trade compatibility response." },
    "activity/orders/route.ts": { "contracts": ["shared/activity/contract-orders.ts"] },
    "activity/route.ts": { "contracts": ["shared/activity/contract.ts", "shared/cards/transactions-contract.ts"] },
    "admin/[...path]/route.ts": { "contracts": ["shared/operator/contract.ts"], "methods": { "GET": { "contracts": ["shared/operator/contract.ts"] }, "HEAD": { "contracts": ["shared/operator/contract.ts"] }, "POST": { "contracts": ["shared/operator/contract.ts"] }, "PUT": { "contracts": ["shared/operator/contract.ts"] }, "PATCH": { "contracts": ["shared/operator/contract.ts"] }, "DELETE": { "contracts": ["shared/operator/contract.ts"] }, "OPTIONS": { "contracts": ["shared/operator/contract.ts"] } }, "client": "The operator API fallback is not called by a Home client; admin pages render on the server." },
    "admin/audit/route.ts": { "contracts": ["shared/operator-settings/contract.ts"], "client": "The audit API has no Home client fetcher; admin pages render on the server." },
    "admin/session/route.ts": { "contracts": ["shared/operator/contract.ts"], "client": "The operator session API has no Home client fetcher; admin pages render on the server." },
    "admin/settings/[domain]/route.ts": { "contracts": ["shared/operator-settings/contract.ts"], "methods": { "GET": { "contracts": ["shared/operator-settings/contract.ts"] }, "PUT": { "contracts": ["shared/operator-settings/contract.ts"] } } },
    "admin/settings/route.ts": { "contracts": ["shared/operator-settings/contract.ts"], "client": "The settings API has no Home client fetcher; admin pages render on the server." },
    "admin/support/assistant/credential/route.ts": { "contracts": ["shared/support/contract.ts"], "methods": { "GET": { "contracts": ["shared/support/contract.ts"] }, "PUT": { "contracts": ["shared/support/contract.ts"] }, "DELETE": { "contracts": ["shared/support/contract.ts"] } } },
    "admin/support/conversations/[id]/handler/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "admin/support/conversations/[id]/messages/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "admin/support/conversations/[id]/read/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "admin/support/conversations/[id]/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "admin/support/conversations/[id]/status/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "admin/support/conversations/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "admin/support/summary/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "auth/base/logout/route.ts": { "exempt": { "kind": "status", "reason": "Native-session logout clears cookies; the client checks only response status and never parses its JSON body." } },
    "auth/base/nonce/route.ts": { "contracts": ["shared/account/contracts/base-nonce.ts"] },
    "auth/base/verify/route.ts": { "contracts": ["shared/account/contracts/base-verify.ts"] },
    "balances/route.ts": { "contracts": ["shared/balances/contract.ts"] },
    "borrow/markets/[marketId]/route.ts": { "contracts": ["shared/borrowing/contract.ts"] },
    "borrow/route.ts": { "contracts": ["shared/borrowing/contract.ts"] },
    "cards/[id]/ephemeral-key/route.ts": { "contracts": ["shared/cards/contract.ts"] },
    "cards/[id]/freeze/route.ts": { "contracts": ["shared/cards/contract.ts"] },
    "cards/[id]/unfreeze/route.ts": { "contracts": ["shared/cards/contract.ts"] },
    "cards/enrollment/route.ts": { "contracts": ["shared/cards/contract.ts"] },
    "cards/route.ts": { "contracts": ["shared/cards/contract.ts"], "methods": { "GET": { "contracts": ["shared/cards/contract.ts"] }, "POST": { "contracts": ["shared/cards/contract.ts"] } } },
    "cards/spending/route.ts": { "contracts": ["shared/cards/allowance-contract.ts"] },
    "cards/webhooks/bridge/route.ts": { "exempt": { "kind": "webhook", "reason": "Bridge sends signed provider-defined events; Home returns acknowledgement status without a parsed client body." } },
    "cards/webhooks/immersve/[topic]/route.ts": { "exempt": { "kind": "webhook", "reason": "Immersve sends provider-defined event notifications; Home returns acknowledgement status without a parsed client body." } },
    "cards/webhooks/stripe/route.ts": { "exempt": { "kind": "webhook", "reason": "Stripe sends signed provider-defined events; Home returns acknowledgement status without a parsed client body." } },
    "client-errors/route.ts": { "exempt": { "kind": "status", "reason": "The client error transport resolves only the response status and never parses a JSON body." } },
    "client-performance/route.ts": { "contracts": ["shared/observability/client-performance.contract.ts"] },
    "funding/orders/[id]/cancel/route.ts": { "contracts": ["shared/funding/contracts/order-cancellation.ts"] },
    "funding/orders/[id]/resolve/route.ts": { "contracts": ["shared/funding/contracts/order-resolution.ts"] },
    "funding/orders/[id]/route.ts": { "contracts": ["shared/funding/contracts/order.ts"], "methods": { "GET": { "contracts": ["shared/funding/contracts/order.ts"] } } },
    "funding/orders/route.ts": { "contracts": ["shared/funding/contracts/open-order.ts", "shared/funding/contracts/order.ts"], "methods": { "GET": { "contracts": ["shared/funding/contracts/open-order.ts"] }, "POST": { "contracts": ["shared/funding/contracts/order.ts"] } } },
    "funding/provider-customers/route.ts": { "contracts": ["shared/funding/contracts/provider-customers.ts"] },
    "funding/provider-customers/verification/route.ts": { "contracts": ["shared/funding/contracts/provider-customers.ts"] },
    "funding/providers/route.ts": { "contracts": ["shared/funding/contracts/providers.ts"] },
    "funding/quotes/route.ts": { "contracts": ["shared/funding/contracts/quotes.ts"] },
    "funding/webhooks/[provider]/route.ts": { "exempt": { "kind": "webhook", "reason": "Funding providers send provider-defined webhook events; Home only acknowledges their delivery status." } },
    "invest/asset/route.ts": { "contracts": ["shared/invest/contracts/asset-resolution.ts"] },
    "invest/discover/route.ts": { "contracts": ["shared/invest/contracts/discover.ts"] },
    "invest/search/route.ts": { "contracts": ["shared/invest/contracts/search.ts"] },
    "invites/link/route.ts": { "contracts": ["shared/invites/contract.ts"] },
    "market-prices/history/route.ts": { "contracts": ["shared/invest/contracts/market-price-history.ts"] },
    "market-prices/route.ts": { "contracts": ["shared/invest/contracts/market-prices.ts"] },
    "market-prices/stats/route.ts": { "contracts": ["shared/invest/contracts/market-stats.ts"] },
    "savings/vaults/route.ts": { "contracts": ["shared/savings/contracts/vaults.ts"] },
    "session/route.ts": { "contracts": ["shared/account/contracts/session.ts"] },
    "support/chat/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "support/handoff/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "support/read/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "support/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "support/summary/route.ts": { "contracts": ["shared/support/contract.ts"] },
    "trades/route.ts": { "contracts": ["shared/trading/contract.ts"] },
    "trades/stock-eligibility/route.ts": { "contracts": ["shared/trading/contract-stock-eligibility.ts"] },
    "transfers/recent-recipients/route.ts": { "contracts": ["shared/transfers/contracts/recipients.ts"] },
    "transfers/recipient-name/route.ts": { "contracts": ["shared/transfers/contracts/recipients.ts"] },
    "webhooks/cdp/route.ts": { "exempt": { "kind": "webhook", "reason": "CDP sends signed provider-defined wallet activity; Home returns only webhook acknowledgement status." } }
  },
  "appRoutes": {
    "app/coverage.csv/route.ts": { "exempt": { "kind": "document", "reason": "The coverage CSV is downloaded as a document and is never parsed by a Home client." } },
    "app/invite/[code]/route.ts": { "exempt": { "kind": "redirect", "reason": "Invite landing links answer with a 303 redirect to /home or / and return no parsed body." } }
  },
  "baseline": {
    "routesWithoutVersionedParser": {
      "actions/[id]/confirm/route.ts": ["shared/actions/contracts/confirm.ts"],
      "actions/[id]/route.ts": ["shared/actions/contracts/get.ts"],
      "actions/prepare/route.ts": ["shared/actions/contracts/prepare.ts"],
      "actions/trade-pending/route.ts": ["shared/actions/contracts/trade-pending.ts"]
    },
    "unversionedContracts": [
      "shared/actions/contracts/confirm.ts",
      "shared/actions/contracts/get.ts",
      "shared/actions/contracts/prepare.ts",
      "shared/fees/contract.ts",
      "shared/funding/contracts/errors.ts",
      "shared/funding/provider-contract.ts"
    ],
    "parserlessContracts": [
      "shared/actions/contracts/trade-pending.ts",
      "shared/funding/provider-contract.ts"
    ],
    "handlerUnlinked": {},
    "clientUnlinked": {
      "access/route.ts": ["shared/access/contract.ts"],
      "actions/[id]/handle/route.ts": ["shared/actions/contracts/handle.ts"],
      "activity/route.ts": ["shared/activity/contract.ts", "shared/cards/transactions-contract.ts"]
    },
    "undeclaredHandlerContracts": {
      "actions/[id]/confirm/route.ts": ["shared/actions/contracts/prepare.ts", "shared/cards/allowance-contract.ts"],
      "actions/[id]/retry/route.ts": ["shared/cards/allowance-contract.ts"],
      "actions/prepare/route.ts": ["shared/trading/contract.ts"],
      "auth/base/verify/route.ts": ["shared/account/contracts/base-nonce.ts"],
      "market-prices/stats/route.ts": ["shared/invest/contracts/market-price-history.ts"]
    }
  }
}
