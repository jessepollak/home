{
  "name": "@home/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "bun run db:migrate && next build",
    "start": "next start",
    "storybook": "storybook dev --host 127.0.0.1 --port ${STORYBOOK_PORT:-6006} --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "review:context": "bun run scripts/review-context.ts",
    "lint": "oxlint -c .oxlintrc.jsonc --deny-warnings --report-unused-disable-directives --disable-nested-config .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun test --max-concurrency 1",
    "knip": "knip --production --no-progress",
    "live-login": "bun run live-login.ts",
    "fixture-session": "bash fixture-session.sh",
    "test:stories": "vitest run",
    "test:browser-smoke": "playwright test --config playwright.config.ts",
    "test:browser-install": "playwright install --with-deps chromium",
    "db:migrate": "bun --conditions=react-server ./server/db/migrate.ts",
    "db:backfill-operator": "bun --conditions=react-server ./server/operator-events/backfill-command.ts",
    "figma:connect:parse": "figma connect parse --exit-on-unreadable-files --outFile /dev/null",
    "figma:connect:publish": "figma connect publish --exit-on-unreadable-files",
    "figma:variables": "node scripts/figma-variables.mjs",
    "figma:variables:dry-run": "node scripts/figma-variables.mjs --dry-run",
    "secrets:rotate": "bun --conditions=react-server ../../scripts/secret-envelopes.ts"
  },
  "dependencies": {
    "@base-org/account": "2.5.10",
    "@base-ui/react": "1.8.0",
    "@coinbase/cdp-core": "0.0.123",
    "@coinbase/cdp-hooks": "0.0.123",
    "@coinbase/cdp-sdk": "1.55.0",
    "@number-flow/react": "0.6.2",
    "@opentelemetry/api": "1.9.1",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-table": "8.21.3",
    "@vercel/otel": "2.1.3",
    "@vercel/speed-insights": "2.0.0",
    "@zkp2p/cash": "0.5.3",
    "@zkp2p/sdk": "0.14.1",
    "class-variance-authority": "0.7.1",
    "cn": "0.3.0",
    "input-otp": "1.5.0",
    "liveline": "0.0.7",
    "lucide-react": "1.42.0",
    "motion": "13.2.0",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "uqr": "0.1.3",
    "viem": "2.56.3"
  },
  "devDependencies": {
    "@figma/code-connect": "2.0.1",
    "@happy-dom/global-registrator": "20.14.0",
    "@playwright/test": "1.55.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-designs": "11.1.4",
    "@storybook/addon-mcp": "10.6.0",
    "@storybook/addon-vitest": "10.6.0",
    "@storybook/nextjs-vite": "10.6.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "16.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^20",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "4.1.11",
    "@vitest/browser-playwright": "4.1.11",
    "@vitest/runner": "4.1.11",
    "agentation": "3.0.2",
    "knip": "6.37.0",
    "msw": "2.15.0",
    "msw-storybook-addon": "3.0.3",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "storybook": "10.6.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  },
  "packageManager": "bun@1.3.12",
  "msw": {
    "workerDirectory": [
      ".storybook/static"
    ]
  }
}
