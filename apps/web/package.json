{
  "name": "@home/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "bun run db:migrate && next build",
    "start": "next start",
    "storybook": "storybook dev --host 127.0.0.1 --port ${STORYBOOK_PORT:-6006} --no-open",
    "build-storybook": "storybook build --output-dir storybook-static",
    "review:context": "bun run scripts/review-context.ts",
    "review:links": "bun run scripts/review-links.ts",
    "profile:activity": "bun run scripts/activity-scroll-profile.ts",
    "profile:navigation": "bun run scripts/navigation-profile.ts",
    "perf:budget": "bun run scripts/performance/budget.ts",
    "perf:seeds": "bun run scripts/performance/seeds-check.ts",
    "profile:device": "bun run scripts/device-profile/cli.ts",
    "perf:cpu-check": "bun run scripts/performance/cpu-check.ts",
    "lint": "next typegen && oxlint -c .oxlintrc.jsonc --deny-warnings --report-unused-disable-directives --disable-nested-config .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "bun run scripts/unit-tests.ts",
    "knip": "knip --production --no-progress",
    "live-login": "bun run live-login.ts",
    "fixture-session": "bash fixture-session.sh",
    "fixture-server": "bun run scripts/fixture-server.ts",
    "test:stories": "vitest run",
    "test:stories:explorations": "HOME_STORY_TEST_EXPLORATIONS=1 vitest run",
    "test:browser-smoke": "playwright test --config playwright.config.ts",
    "test:browser-regression": "HOME_PLAYWRIGHT_REGRESSION=1 playwright test --config playwright.config.ts",
    "test:browser-products": "bun run scripts/products-browser.ts",
    "test:browser-production-navigation": "HOME_PLAYWRIGHT_PRODUCTION=1 playwright test --config playwright.config.ts --project chromium-production-navigation",
    "test:browser-install": "playwright install --with-deps chromium",
    "db:migrate": "bun --conditions=react-server ./server/db/migrate.ts",
    "db:backup-check": "bun --conditions=react-server ./server/db/backup-check-command.ts",
    "db:settings-fingerprint": "bun --conditions=react-server ./server/db/settings-fingerprint-command.ts",
    "db:backfill-operator": "bun --conditions=react-server ./server/operator-events/backfill-command.ts",
    "db:backfill-customer-ids": "bun --conditions=react-server ./server/customers/record-ids-backfill-command.ts",
    "cdp-swaps:checkpoint": "bun --conditions=react-server ./server/actions/kinds/trade/checkpoint-command.ts",
    "invest:history-sample": "bun --conditions=react-server ./scripts/invest-history-sample.ts",
    "invest-catalog:refresh": "bun --conditions=react-server ./scripts/invest-catalog/refresh.ts",
    "history:reconcile": "bun --conditions=react-server ./server/balances/history/reconcile-command.ts",
    "secrets:rotate": "bun --conditions=react-server ../../scripts/secret-envelopes.ts",
    "profile:modals": "bun run scripts/modal-open-profile.ts"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.103",
    "@ai-sdk/react": "^4.0.130",
    "@base-org/account": "2.5.10",
    "@base-ui/react": "1.8.0",
    "@coinbase/cdp-core": "0.0.123",
    "@coinbase/cdp-hooks": "0.0.123",
    "@coinbase/cdp-sdk": "1.55.0",
    "@number-flow/react": "^0.6.2",
    "@opentelemetry/api": "^1.9.1",
    "@stripe/stripe-js": "9.17.0",
    "@tanstack/react-query": "^5.104.1",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.13",
    "@vercel/functions": "^3.9.11",
    "@vercel/otel": "^2.1.3",
    "@vercel/speed-insights": "^2.0.0",
    "@zkp2p/cash": "0.5.3",
    "@zkp2p/sdk": "0.14.1",
    "ai": "^7.0.118",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "idb-keyval": "^6.3.0",
    "input-otp": "^1.5.0",
    "liveline": "^0.0.7",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.51.0",
    "motion": "^13.5.1",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "uqr": "^0.1.3",
    "viem": "2.56.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/oxide": "^4.3.3",
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/bun": "^1.4.1",
    "@types/node": "^20",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser": "^4.1.11",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/runner": "^4.1.11",
    "agentation": "^3.1.2",
    "es-module-lexer": "^2.3.2",
    "fake-indexeddb": "^6.2.5",
    "fast-check": "^4.10.2",
    "knip": "^6.39.0",
    "msw": "^2.15.0",
    "msw-storybook-addon": "^3.0.3",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.3.12",
  "msw": {
    "workerDirectory": [
      ".storybook/static"
    ]
  }
}
