<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.jessepollak.home-verification-canary</string>
  <key>ProgramArguments</key>
  <array>
    <string>__HOME_REPOSITORY__/scripts/verify/canary.sh</string>
    <string>scheduled</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__HOME_REPOSITORY__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>HOME_VERIFY_PRODUCTION_URL</key>
    <string>https://__HOME_PRODUCTION_HOST__</string>
    <key>HOME_VERIFY_ACCOUNT_EMAIL</key>
    <string>__HOME_VERIFY_ACCOUNT_EMAIL__</string>
    <key>HOME_VERIFY_GMAIL_CREDENTIALS</key>
    <string>__HOME_DIRECTORY__/.home-verify/gmail.json</string>
    <key>HOME_VERIFY_ROLE</key>
    <string>factory</string>
    <!-- Optional: instead of provisioning HOME_ACCESS_PASSWORD directly, set
         HOME_ACCESS_PASSWORD_OP_REF to a 1Password reference (for example
         op://j/access/password). When HOME_ACCESS_PASSWORD is empty, canary.sh
         resolves the reference with `op read` without echoing it. -->
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>3</integer>
    <key>Minute</key>
    <integer>0</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>__HOME_DIRECTORY__/.home-verify/canary/launchd.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>__HOME_DIRECTORY__/.home-verify/canary/launchd.stderr.log</string>
</dict>
</plist>
