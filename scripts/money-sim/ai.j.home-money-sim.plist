<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/money-sim/install-launchd.sh replaces __HOME__ and installs it. See docs/money-sim-nightly.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.j.home-money-sim</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/share/home-money-sim/nightly.sh</string>
    <string>--scheduled</string>
  </array>
  <!-- Hourly check; --scheduled runs at most once per 20h and only between 01:00 and 06:00. -->
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/home-money-sim/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/home-money-sim/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>__HOME__/.bun/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
