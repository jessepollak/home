<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: scripts/money-sim/install-launchd.sh replaces __HOME__ and __PATH__ and installs it. See docs/money-sim-nightly.md. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>ai.j.home-money-sim</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/.local/share/home-money-sim/nightly.sh</string>
    <string>--scheduled</string>
  </array>
  <!-- 02:00 nightly, then hourly so a night missed in sleep or a dark wake runs later; --scheduled runs each night slot once. -->
  <key>StartCalendarInterval</key>
  <dict><key>Hour</key><integer>2</integer><key>Minute</key><integer>0</integer></dict>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><false/>
  <key>LowPriorityIO</key><true/>
  <key>Nice</key><integer>10</integer>
  <key>StandardOutPath</key><string>__HOME__/Library/Logs/home-money-sim/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/Library/Logs/home-money-sim/launchd.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key><string>__HOME__</string>
    <key>PATH</key><string>__PATH__</string>
  </dict>
</dict>
</plist>
