{
  "imports": [
    "@import \"shadcn/tailwind.css\"",
    "@import \"tailwindcss\"",
    "@import \"tw-animate-css\""
  ],
  "customVariants": [
    "@custom-variant dark (&:is(.dark *))"
  ],
  "sources": [
    "@source not \"../oxlint\""
  ],
  "topLevel": [
    ".dark",
    ":root",
    "@layer base",
    "@layer utilities",
    "@media (display-mode: standalone)",
    "@supports (height: 100dvh)",
    "@theme inline"
  ],
  "themeInline": {
    "properties": [
      "--color-accent",
      "--color-accent-foreground",
      "--color-background",
      "--color-border",
      "--color-card",
      "--color-card-foreground",
      "--color-destructive",
