      "owner": [
        "#1075",
        "#1137"
      ],
      "reason": "Shell layout variable remains owned by shell work."
    },
    {
      "entry": "@supports (height: 100dvh)",
      "owner": [
        "#1075",
        "#1137"
      ],
      "reason": "Shell viewport overhang fallback remains owned by shell work."
    },
    {
      "entry": "@media (display-mode: standalone)",
