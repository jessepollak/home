      "--color-muted",
      "--color-muted-foreground",
      "--color-overlay",
      "--color-payout-cashapp",
      "--color-payout-cashapp-foreground",
      "--color-payout-monzo",
      "--color-payout-monzo-foreground",
      "--color-payout-revolut",
