# Copy this file to apps/web/.env.local, which is where Next.js reads it.
# A copy left at the repository root is ignored.

# Optional replaceable pre-release deployment access gate. Set required to 1.
# The server-only password must be at least 8 UTF-8 bytes; prefer a longer
# random value. The independent server-only signing secret must be at least 32
# random UTF-8 bytes. Rotating either value invalidates every access cookie.
# Never use committed literal secret fixtures. This gate remains independent
# from Home customer sessions and future administrator authority.
HOME_ACCESS_REQUIRED=
HOME_ACCESS_PASSWORD=
HOME_ACCESS_SIGNING_SECRET=

# Optional server-only administrator allowlist: comma-separated 0x + 40 hex Base
# smart-account addresses; ASCII whitespace around each item is allowed. Empty,
# duplicate, or malformed entries reject the entire list; unset/blank denies all.
HOME_OPERATOR_ADDRESSES=

# Provisioned live-login runners use a dedicated bot mailbox. The Gmail
# readonly credentials file stays outside the repo with mode 0600. Inspect
# the bot mailbox's sender before overriding the default no-reply@info.coinbase.com.
# This is not a role gate: credential provisioning determines live access.
HOME_VERIFY_ACCOUNT_EMAIL=
HOME_VERIFY_GMAIL_CREDENTIALS=
HOME_VERIFY_OTP_SENDER=
# Optional path for live-login's private current-user-owned mode-0600 KEY=VALUE file.
HOME_VERIFY_ENV_FILE=
# Handle and host normally come from private ~/.home-verify/live.env.
# An empty host value in copied .env.local defers to that file.
# HOME_VERIFY_CASHOUT_HANDLE=
# Bot account's full 0x wallet address: required before a marked click; live-login --check-account compares it with the review `From` row without printing it. Normally from private live.env.
HOME_VERIFY_ACCOUNT_ADDRESS=
HOME_VERIFY_PRODUCTION_URL=

# Fraction of page loads that report navigation and scroll timing; default 0.25, 0 disables; build-time.
NEXT_PUBLIC_HOME_INTERACTION_SAMPLE_RATE=

# Public CDP project configuration for email sign-in.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Server-only secret that must be at least 32 UTF-8 bytes after trimming. It gates Base Account
# sign-in and signs its challenge/session cookies plus the CDP render hint.
# Never expose with a NEXT_PUBLIC_ prefix.
HOME_SESSION_SECRET=

# Server-only CDP credentials. Never expose these with a NEXT_PUBLIC_ prefix.
# Server-only CDP paymaster URL; unset disables USDC network fees.
CDP_PAYMASTER_URL=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional public HTTPS origin override for app-managed CDP webhook subscriptions.
# Production defaults to https://${VERCEL_PROJECT_PRODUCTION_URL}.
HOME_WEBHOOK_ORIGIN=

# Platform-injected by Vercel; do not configure these manually.
# VERCEL_ENV=
# VERCEL_DEPLOYMENT_ID=
# VERCEL_GIT_COMMIT_SHA=
# VERCEL_GIT_COMMIT_REF=

# Server-only Activity history source. CDP SQL remains the default until the
# Address History REST rollout gate is proven end to end. cdp-address-history
# uses the server CDP API key above; invalid values fail closed.
ACTIVITY_HISTORY_SOURCE=cdp-sql

# CDP SQL uses the CDP server key above (CDP_API_KEY_ID/SECRET) through a
# signed JWT; no separate SQL key is needed. Leave both lines blank. Only set
# CDP_SQL_AUTH_MODE=client-api-key with CDP_SQL_CLIENT_API_KEY to use a
# dedicated SQL client key instead.
CDP_SQL_AUTH_MODE=
CDP_SQL_CLIENT_API_KEY=

# Home browsing works without credentials; account sign-in requires these values.
# Store real local values in apps/web/.env.local (gitignored, permission 0600).

# Home disables CDP server SDK telemetry when these are unset. Set either to
# false only as an intentional operator override after reviewing CDP's policy.
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true

# Server-only Codex key for market-price snapshots. Never expose to the browser.
CODEX_API_KEY=

# Server-only Base JSON-RPC for money-path reads (portfolio, savings
# prepare, vault convert, borrow, transfer receipts, trading). Production
# and Preview should set this to a CDP Node HTTPS URL for Base mainnet.
# Shape: https://api.developer.coinbase.com/rpc/v1/base/<CLIENT_API_KEY>
# The client API key is the last path segment; userinfo and fragments
# are rejected. Never expose with a NEXT_PUBLIC_ prefix. When unset, local
# development falls back to rate-limited public https://mainnet.base.org;
# that fallback is not the configured path, so live probes and research
# should use a configured BASE_RPC_URL.
# Mint: CDP Portal → Node → Base Mainnet → copy the HTTPS endpoint.
# https://docs.cdp.coinbase.com/data/node/quickstart
# Activity's CDP Address History REST source does not use this RPC URL.
BASE_RPC_URL=

# Server-only Ethereum mainnet RPC used for standard .eth recipient resolution.
# Production and Preview should set a dedicated HTTPS endpoint. CCIP Read is
# disabled; Home performs only onchain ENS resolution. Leave unset locally to
# use the public https://ethereum.reth.rs/rpc fallback.
ETHEREUM_RPC_URL=

# Optional. Coinbase Wallet status RPC used by the server to reconcile Base
# Account bundle ids (wallet_getCallsStatus) into transaction hashes when the
# client stopped polling. HTTPS only; leave unset to use
# https://rpc.wallet.coinbase.com. Override only for tests or staging.
BASE_ACCOUNT_STATUS_RPC_URL=

# Any PostgreSQL 14+ works: Neon (keep `sslmode=require`), your own, or local
# `bun run db:up` -> postgresql://home:home@127.0.0.1:54320/home_local
# Never expose this value with a NEXT_PUBLIC_ prefix. Apply the checked-in
# `bun run db:migrate` before serving authenticated actions.
DATABASE_URL=

# Optional emergency override. Vercel preview/development builds skip migrations
# even with DATABASE_URL; see docs/vercel-deploy.md#environment before setting it.
HOME_MIGRATE_ON_BUILD=

# Funding provider seam. FUNDING_QUOTE_SECRET signs short-lived quote claims;
# generate at least 32 random characters. A binding remains inert until every
# environment variable declared by its manifest is configured.
FUNDING_QUOTE_SECRET=
# Provider-scoped local dry runs. The only accepted non-empty value is
# "sandbox"; unset means production. Never set these on production Vercel.
COINBASE_ONRAMP_MODE=
PEER_OFFRAMP_MODE=
# Currently unused. Reserved for a future sandbox provider that requires the
# end user's public IP; Coinbase Embedded Orders omits it. Never set on Vercel.
FUNDING_SANDBOX_CLIENT_IP=
IDRX_CLIENT_ID=
IDRX_CLIENT_SECRET=
IDRX_CUSTOMER_NAME=
# Server-only Ripio Ramps production credentials. Configure a complete matching
# client pair and dashboard-generated webhook secret per enabled country; there
# is no sandbox, shared secret, or unsuffixed fallback.
RIPIO_CLIENT_ID_AR=
RIPIO_CLIENT_SECRET_AR=
RIPIO_WEBHOOK_SECRET_AR=
RIPIO_CLIENT_ID_BR=
RIPIO_CLIENT_SECRET_BR=
RIPIO_WEBHOOK_SECRET_BR=
RIPIO_CLIENT_ID_CO=
RIPIO_CLIENT_SECRET_CO=
RIPIO_WEBHOOK_SECRET_CO=

# Legacy Peer cash-out switch. Only `1` offers Peer, and it is read only until
# Admin → Settings → Money in and out is first saved; after that the saved
# setting wins and this value is shown as "set but ignored". The provider README
# tracks the skipped staging proof and the outstanding Peer corridor confirmation.
PEER_OFFRAMP_ENABLED=

# Immersve Cards: disabled unless ENABLED=1 and every field is set. Server-only.
# MODE is required when enabled: sandbox selects a private Base Sepolia channel,
# production selects Base mainnet.
# Use Home-owned program/channel/storage, never the shared public Amoy values.
IMMERSVE_ENABLED=
IMMERSVE_MODE=
IMMERSVE_API_KEY=
IMMERSVE_API_SECRET=
IMMERSVE_PARTNER_ACCOUNT_ID=
IMMERSVE_CLIENT_APPLICATION_ID=
IMMERSVE_CARD_PROGRAM_ID=
IMMERSVE_FUNDING_CHANNEL_ID=
IMMERSVE_FUNDS_STORAGE_ADDRESS=
IMMERSVE_FUNDING_TYPE=

# Bridge + Stripe Issuing event ingress. Disabled unless every field is set.
# MODE must be sandbox or production. Spender is program-specific; the public
# factory address does not establish Home's actual issuer/spender.
BRIDGE_ENABLED=
BRIDGE_MODE=
BRIDGE_STRIPE_API_VERSION=
BRIDGE_WEBHOOK_PUBLIC_KEY=
BRIDGE_STRIPE_WEBHOOK_SECRET=
# Card journey reads, enabled separately from webhook ingress. Stripe key must match mode.
BRIDGE_CARDS_ENABLED=
# Production requires crypto_wallet; financial_account is sandbox-only.
BRIDGE_API_KEY=
BRIDGE_STRIPE_SECRET_KEY=
BRIDGE_STRIPE_CARD_FUNDING=
BRIDGE_STRIPE_FINANCIAL_ACCOUNT=
# Only sandbox loopback HTTP origin for a local fake; unset elsewhere.
BRIDGE_API_BASE_URL=
# Stripe publishable key (pk_test_ in sandbox, pk_live_ in production) for the
# browser-only Issuing Elements card-detail reveal. Public by design; when unset,
# the Card screen does not offer Card details.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# Opt-in test-mode read of a pre-existing Stripe Issuing test card; never CI.
CARDS_STRIPE_LIVE_TEST=
BRIDGE_PROGRAM_SPENDER=
# Optional checksummed revoke-only historical spenders; never include the current spender.
BRIDGE_PROGRAM_RETIRED_SPENDERS=
# Whole USDC, positive and at most 1000000; unset disables new card allowance sets.
BRIDGE_CARD_ALLOWANCE_MAX_USDC=

# Optional local unit-test runner file batch size, per-batch max RSS (MiB), and
# file-order group size.
HOME_UNIT_TEST_BATCH_SIZE=
HOME_UNIT_TEST_MAX_RSS_MB=
HOME_UNIT_TEST_FILE_ORDER_GROUP_SIZE=

# Synthetic public-sandbox SIWE probe only: bun --conditions=react-server
# apps/web/scripts/immersve-probe.ts. Supply test credentials and shared public
# IDs via env at invocation; never use personal accounts or production secrets.
IMMERSVE_PROBE_API_KEY=
IMMERSVE_PROBE_API_SECRET=
IMMERSVE_PROBE_PARTNER_ACCOUNT_ID=
IMMERSVE_PROBE_CLIENT_APPLICATION_ID=

# DB-only protection for reusable provider tokens and balance-webhook signing secrets.
# Generate 32 random bytes as unpadded base64url:
# openssl rand -base64 32 | tr '+/' '-_' | tr -d '='.
# Unset keys disable new webhook subscription creation and token persistence.
# All writers of one DATABASE_URL must share
# the key set/version; previews must never use an unrelated same-version key.
HOME_SECRET_ENCRYPTION_KEY=
HOME_SECRET_KEY_VERSION=
HOME_SECRET_ENCRYPTION_KEY_PREVIOUS=

# Trust x-vercel-ip-country for stock eligibility off Vercel only when your edge overwrites it.
HOME_TRUST_EDGE_COUNTRY_HEADER=

# Optional fixture server and Playwright port; defaults to 3199 when unset.
HOME_FIXTURE_PORT=

# Set by test:browser-production-navigation to select the production navigation project
# (pinned local next build, then next start); ordinary browser smoke uses next dev.
HOME_PLAYWRIGHT_PRODUCTION=

# Builds the React profiling client the performance job attributes commits with.
# Set only for that harness build; it changes the client bundle and its distDir.
HOME_PERF_REACT_PROFILING=

# Set by test:browser-regression to run all fixture browser regressions instead of tagged smoke.
HOME_PLAYWRIGHT_REGRESSION=

# Test-only Products browser persistence: disposable loopback PostgreSQL URL that names its database user.
# Export for test:browser-products, not in a Next-loadable .env file.
# The runner creates/drops only its randomized schema, excluding public.
HOME_PRODUCTS_PG_TEST_URL=
# Set only by test:browser-products to select its isolated settings project.
HOME_PLAYWRIGHT_PRODUCTS=

# Optional Android platform tools for physical-device profiling; the directory
# holding platform-tools/adb. Defaults to ~/Library/Android/sdk when unset.
ANDROID_HOME=

# Optional clip runner SSH destination and checkout directory (operator shell only).
# Keep device identities and private checkout locations out of public evidence.
HOME_CLIP_REMOTE=
HOME_CLIP_REMOTE_DIR=

# Dedicated account-deletion HMAC key, at least 32 UTF-8 bytes. Keep stable while tombstones exist.
ACCOUNT_DELETION_TOMBSTONE_SECRET=
