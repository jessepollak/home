# Copy this file to apps/web/.env.local, which is where Next.js reads it.
# A copy left at the repository root is ignored.

# Public CDP project configuration for email sign-in.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Server-only secret that must be at least 32 characters. It gates Base Account
# sign-in and signs its challenge/session cookies plus the CDP render hint.
# Never expose with a NEXT_PUBLIC_ prefix.
HOME_SESSION_SECRET=

# Server-only CDP credentials. Never expose these with a NEXT_PUBLIC_ prefix.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
# Optional public HTTPS origin override for app-managed CDP webhook subscriptions.
# Production defaults to https://${VERCEL_PROJECT_PRODUCTION_URL}.
HOME_WEBHOOK_ORIGIN=

# Server-only Activity history source. CDP SQL remains the default until the
# Address History REST rollout gate is proven end to end. cdp-address-history
# uses the server CDP API key above; invalid values fail closed.
ACTIVITY_HISTORY_SOURCE=cdp-sql

# Optional CDP SQL auth. Default mode is client-api-key and uses only the
# dedicated SQL client key. Set signed-jwt explicitly to use the project key
# above for the fixed CDP SQL endpoint.
CDP_SQL_AUTH_MODE=client-api-key
CDP_SQL_CLIENT_API_KEY=

# Home browsing works without credentials; account sign-in requires these values.
# Store real local values in apps/web/.env.local (gitignored, permission 0600).

# Home disables CDP server SDK telemetry when these are unset. Set either to
# false only as an intentional operator override after reviewing CDP's policy.
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true

# Server-only Codex key for market-price snapshots. Never expose to the browser.
CODEX_API_KEY=

# Server-only Base JSON-RPC for money-path reads (portfolio, savings
# prepare, vault convert, borrow, transfer receipts, trading). Production
# and Preview should set this to a CDP Node HTTPS URL for Base mainnet.
# Shape: https://api.developer.coinbase.com/rpc/v1/base/<CLIENT_API_KEY>
# The client API key is the last path segment; userinfo and fragments
# are rejected. Never expose with a NEXT_PUBLIC_ prefix. Leave unset
# locally to use public https://mainnet.base.org.
# Mint: CDP Portal → Node → Base Mainnet → copy the HTTPS endpoint.
# https://docs.cdp.coinbase.com/data/node/quickstart
# Activity's CDP Address History REST source does not use this RPC URL.
BASE_RPC_URL=

# Optional. Coinbase Wallet status RPC used by the server to reconcile Base
# Account bundle ids (wallet_getCallsStatus) into transaction hashes when the
# client stopped polling. HTTPS only; leave unset to use
# https://rpc.wallet.coinbase.com. Override only for tests or staging.
BASE_ACCOUNT_STATUS_RPC_URL=

# Any PostgreSQL 14+ works: Neon (keep `sslmode=require`), your own, or local
# `bun run db:up` -> postgresql://home:home@127.0.0.1:54320/home_local
# Never expose this value with a NEXT_PUBLIC_ prefix. Apply the checked-in
# `bun run db:migrate` before serving authenticated actions.
DATABASE_URL=

# Optional emergency override. Vercel preview/development builds skip migrations
# even with DATABASE_URL because those deployments currently share production.
HOME_MIGRATE_ON_BUILD=

# Funding provider seam. FUNDING_QUOTE_SECRET signs short-lived quote claims;
# generate at least 32 random characters. A binding remains inert until every
# environment variable declared by its manifest is configured.
FUNDING_QUOTE_SECRET=
# Provider-scoped local dry runs. The only accepted non-empty value is
# "sandbox"; unset means production. Never set these on production Vercel.
COINBASE_ONRAMP_MODE=
PEER_OFFRAMP_MODE=
# Currently unused. Reserved for a future sandbox provider that requires the
# end user's public IP; Coinbase Embedded Orders omits it. Never set on Vercel.
FUNDING_SANDBOX_CLIENT_IP=
IDRX_CLIENT_ID=
IDRX_CLIENT_SECRET=
# Server-only Ripio Ramps production credentials. Configure a complete matching
# client pair and dashboard-generated webhook secret per enabled country; there
# is no sandbox, shared secret, or unsuffixed fallback.
RIPIO_CLIENT_ID_AR=
RIPIO_CLIENT_SECRET_AR=
RIPIO_WEBHOOK_SECRET_AR=
RIPIO_CLIENT_ID_BR=
RIPIO_CLIENT_SECRET_BR=
RIPIO_WEBHOOK_SECRET_BR=
RIPIO_CLIENT_ID_CO=
RIPIO_CLIENT_SECRET_CO=
RIPIO_WEBHOOK_SECRET_CO=

# Peer cash-out is disabled by default. Keep this unset in production until the
# provider README's separately authorized G2 staging proof and G3 written
# country/corridor confirmations are complete.
PEER_OFFRAMP_ENABLED=
