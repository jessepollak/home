# Public CDP project configuration for email and optional Base Account sign-in.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Opt in to the Base Account SIWE path. Leave unset to show email only.
# The server enforces the same selector before using a verified SIWE address.
NEXT_PUBLIC_ENABLE_BASE_ACCOUNT=

# Server-only CDP credentials. Never expose these with a NEXT_PUBLIC_ prefix.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional CDP SQL auth. Default mode is client-api-key and uses only the
# dedicated SQL client key. Set signed-jwt explicitly to use the project key
# above for the fixed CDP SQL endpoint.
CDP_SQL_AUTH_MODE=client-api-key
CDP_SQL_CLIENT_API_KEY=

# Home browsing works without credentials; account sign-in requires these values.
# Store real local values in apps/web/.env.local (gitignored, permission 0600).

# Home disables CDP server SDK telemetry when these are unset. Set either to
# false only as an intentional operator override after reviewing CDP's policy.
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true

# Server-only Codex key for market-price snapshots. Never expose to the browser.
CODEX_API_KEY=

# Shared Neon/Postgres for hosted money-action persistence. Leave unset for
# local `bun dev` (SQLite under apps/web/.local/). Landing/browse on Vercel
# can deploy without it; money-action routes fail closed unless it is set.
# Never expose with a NEXT_PUBLIC_ prefix. Apply schema from local or CI
# with DATABASE_URL set — not part of the default Vercel build:
# bun run money-actions:migrate
# Or run apps/web/server/money-actions/migrations/001_money_action_operations.sql
# in the Neon SQL editor.
DATABASE_URL=
