# Public CDP project configuration for email and optional Base Account sign-in.
NEXT_PUBLIC_CDP_PROJECT_ID=

# Opt in to the Base Account SIWE path. Leave unset to show email only.
# The server enforces the same selector before using a verified SIWE address.
NEXT_PUBLIC_ENABLE_BASE_ACCOUNT=

# Server-only CDP credentials. Never expose these with a NEXT_PUBLIC_ prefix.
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Optional CDP SQL auth. Default mode is client-api-key and uses only the
# dedicated SQL client key. Set signed-jwt explicitly to use the project key
# above for the fixed CDP SQL endpoint.
CDP_SQL_AUTH_MODE=client-api-key
CDP_SQL_CLIENT_API_KEY=

# Home browsing works without credentials; account sign-in requires these values.
# Store real local values in apps/web/.env.local (gitignored, permission 0600).

# Home disables CDP server SDK telemetry when these are unset. Set either to
# false only as an intentional operator override after reviewing CDP's policy.
DISABLE_CDP_USAGE_TRACKING=true
DISABLE_CDP_ERROR_REPORTING=true

# Server-only Codex key for market-price snapshots. Never expose to the browser.
CODEX_API_KEY=

# Server-only Base JSON-RPC for money-path reads (portfolio, savings
# prepare, vault convert, borrow, transfer receipts, trading). Production
# and Preview should set this to a CDP Node HTTPS URL for Base mainnet.
# Shape: https://api.developer.coinbase.com/rpc/v1/base/<CLIENT_API_KEY>
# The client API key is the last path segment; userinfo and fragments
# are rejected. Never expose with a NEXT_PUBLIC_ prefix. Leave unset
# locally to use public https://mainnet.base.org.
# Mint: CDP Portal → Node → Base Mainnet → copy the HTTPS endpoint.
# https://docs.cdp.coinbase.com/data/node/quickstart
BASE_RPC_URL=

# Shared Neon/Postgres for all money-action persistence. Money-action routes
# fail closed unless DATABASE_URL is set and the retired SQLite store has been
# verified empty of unresolved actions/references. Never expose either value
# with a NEXT_PUBLIC_ prefix. Apply both money-action migrations first:
# bun run money-actions:migrate
DATABASE_URL=
MONEY_ACTION_POSTGRES_CUTOVER=

# Server-only Ripio Ramps production credentials. Configure a complete matching
# pair per enabled country; there is no sandbox or unsuffixed fallback.
RIPIO_CLIENT_ID_AR=
RIPIO_CLIENT_SECRET_AR=
RIPIO_CLIENT_ID_BR=
RIPIO_CLIENT_SECRET_BR=
RIPIO_CLIENT_ID_CO=
RIPIO_CLIENT_SECRET_CO=
